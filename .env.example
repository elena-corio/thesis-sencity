# Copy to .env and fill in. Never commit .env.
# Where the app's photos come from (not a secret): streetview (default, local prototype only) or mapillary (any public
# version; npm run build refuses streetview). Read by the API and by the frontend build.
PHOTO_SOURCE=streetview
# Google Maps Platform key with "Street View Static API" enabled (backend only, never VITE_*).
GOOGLE_MAPS_API_KEY=
# Infrared.city API key (thermal comfort, billed per run; backend only). From your Infrared.city account.
INFRARED_API_KEY=
# OpenRouter API key (Senses predictions, paid per call; backend only, never VITE_*). From openrouter.ai/keys.
OPENROUTER_API_KEY=
# Mapillary photos for the walk (free client token: mapillary.com/dashboard/developers). Server only.
MAPILLARY_ACCESS_TOKEN=

# Sign-in (Clerk, phase 2). From the Clerk dashboard > API keys. The secret key: server only, never VITE_*.
CLERK_SECRET_KEY=
# The publishable key is public by design (it goes into the built frontend).
VITE_CLERK_PUBLISHABLE_KEY=
# Origins a session token may come from, comma-separated (on Render: the site's https address). Empty locally.
CLERK_AUTHORIZED_PARTIES=

# Database. Empty locally: a SQLite file in .local/ (not committed). On Render: set from the Postgres database.
DATABASE_URL=

# Limits (defaults in brackets): chat messages and rating runs per user, and model calls per day for everyone.
LIMIT_CHAT_PER_HOUR=30
LIMIT_CHAT_PER_DAY=100
LIMIT_RUNS_PER_HOUR=10
LIMIT_RUNS_PER_DAY=30
LIMIT_MODEL_CALLS_PER_DAY=2000
