# Copy to .env and fill in. Never commit .env.
# Where the app's photos come from (not a secret): streetview (default, local prototype only) or mapillary (any public
# version; npm run build refuses streetview). Read by the API and by the frontend build.
PHOTO_SOURCE=streetview
# Google Maps Platform key with "Street View Static API" enabled (backend only, never VITE_*).
GOOGLE_MAPS_API_KEY=
# Infrared.city API key (thermal comfort, billed per run; backend only). From your Infrared.city account.
INFRARED_API_KEY=
# OpenRouter API key (Senses predictions, paid per call; backend only, never VITE_*). From openrouter.ai/keys.
OPENROUTER_API_KEY=
# Mapillary photos for the walk (free client token: mapillary.com/dashboard/developers). Server only.
MAPILLARY_ACCESS_TOKEN=
