# Copy to .env and fill in. Never commit .env.
# Google Maps Platform key with "Street View Static API" enabled (backend only, never VITE_*).
GOOGLE_MAPS_API_KEY=
# Infrared.city API key (thermal comfort, billed per run; backend only). From your Infrared.city account.
INFRARED_API_KEY=
# OpenRouter API key (Senses predictions, paid per call; backend only, never VITE_*). From openrouter.ai/keys.
OPENROUTER_API_KEY=
